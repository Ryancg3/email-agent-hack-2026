# Copy to .env and fill in. Use with: uv run --env-file .env <command>
ANTHROPIC_API_KEY=

# Web app only.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Encrypts stored Google tokens; losing it means everyone reconnects Google.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=
# From a "Web application" OAuth client in Google Cloud Console, with redirect URI
# http://localhost:8000/google/callback/ (and the same with 127.0.0.1).
# When hosted, also add https://<your-public-host>/google/callback/ (docs/deploy-railway.md or docs/deploy-render.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only for a custom domain, or a tunnel when testing Gmail push locally: the public
# hostname, without https://. Render and Railway set it themselves.
# APP_HOST=

# Hosted only: set to 1 once your own account exists, to block new sign-ups.
# SIGNUP_CLOSED=1

# Optional: run the agent seconds after an email arrives instead of polling every
# 5 minutes. Needs a public HTTPS URL; see docs/gmail-push.md. Leave empty to poll.
GMAIL_PUBSUB_TOPIC=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
GMAIL_PUSH_TOKEN=
